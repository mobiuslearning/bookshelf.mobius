---
import "../styles/global.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import { site } from "../data/site";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  noIndex?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description = site.description,
  image = "/og.png",
  bodyClass = "",
  noIndex = false,
  hideFooter = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const socialImage = new URL(image, Astro.site ?? site.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta name="theme-color" content="#130d09" />

    <script is:inline>
      try {
        const saved = localStorage.getItem("shelf-theme");
        if (saved === "day" || saved === "night") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
      try {
        const readerTheme = localStorage.getItem("reader-theme");
        if (readerTheme === "night" || readerTheme === "paper") {
          document.documentElement.dataset.readerTheme = readerTheme;
        }
        const readerSize = localStorage.getItem("reader-size");
        if (readerSize) document.documentElement.style.setProperty("--reader-size", readerSize);
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <Navbar />
    <slot />
    {!hideFooter && <Footer />}
    <Search />

    <script>
      // Reveal sections as they scroll into view.
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
      );
      document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));

      // Navbar gains a solid background after the hero.
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      const setHeaderState = () => {
        const solid = window.scrollY > 28;
        header?.classList.toggle("is-scrolled", solid);
      };
      setHeaderState();
      window.addEventListener("scroll", setHeaderState, { passive: true });

      // Theme toggle.
      const applyThemeButtonState = () => {
        const day = document.documentElement.dataset.theme === "day";
        document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
          button.setAttribute("aria-label", day ? "切换到夜读模式" : "切换到日光模式");
          button.setAttribute("aria-pressed", String(day));
        });
      };
      applyThemeButtonState();
      document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const day = document.documentElement.dataset.theme === "day";
          const next = day ? "night" : "day";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("shelf-theme", next);
          } catch {}
          applyThemeButtonState();
        });
      });

      // Mobile menu.
      const menuButton = document.querySelector<HTMLElement>("[data-menu-toggle]");
      const setMenu = (open: boolean) => {
        header?.classList.toggle("is-menu-open", open);
        document.body.classList.toggle("menu-open", open);
        menuButton?.setAttribute("aria-expanded", String(open));
      };
      menuButton?.addEventListener("click", () => {
        setMenu(!header?.classList.contains("is-menu-open"));
      });
      document.querySelectorAll("[data-menu-close]").forEach((el) => {
        el.addEventListener("click", () => setMenu(false));
      });
      document.querySelectorAll("[data-mobile-nav] a").forEach((el) => {
        el.addEventListener("click", () => setMenu(false));
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
      });

      // Use the platform's actual search shortcut label.
      const isApple = /Mac|iPhone|iPad/i.test(navigator.platform ?? "");
      if (!isApple) {
        document.querySelectorAll("[data-search-open] kbd").forEach((el) => {
          el.textContent = "Ctrl K";
        });
      }

      // Back to top.
      document.querySelectorAll<HTMLElement>("[data-back-top]").forEach((button) => {
        button.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      });
    </script>
  </body>
</html>
