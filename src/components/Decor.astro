---
interface Props {
  variant: "plant" | "candle" | "stack" | "bookend" | "lamp" | "ink";
  class?: string;
}
const { variant, class: className = "" } = Astro.props;
---

<div class:list={["decor", `decor--${variant}`, className]} aria-hidden="true">
  {variant === "plant" && (
    <svg viewBox="0 0 120 180" fill="none">
      <defs>
        <linearGradient id="vase" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#d7c3a4" />
          <stop offset="0.45" stop-color="#a98a66" />
          <stop offset="1" stop-color="#715538" />
        </linearGradient>
        <linearGradient id="leaf" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7d8663" />
          <stop offset="1" stop-color="#3f4934" />
        </linearGradient>
      </defs>
      <path d="M45 120h30c0 0 11 18 11 31 0 12-11 17-26 17s-26-5-26-17c0-13 11-31 11-31Z" fill="url(#vase)" />
      <path d="M45 120h30" stroke="#e2d2b5" stroke-opacity=".35" />
      <path d="M42 138c11 4 25 4 36 0" stroke="#5e452d" stroke-opacity=".35" />
      <path d="M60 120V70M60 102c-16-14-26-38-20-58 18 4 30 24 30 44" stroke="#566046" stroke-width="1.4" />
      <path d="M60 88c14-8 24-20 27-36-17-2-30 10-35 26" fill="url(#leaf)" />
      <path d="M60 70c-10-8-15-19-14-31 12 1 20 11 22 23" fill="url(#leaf)" opacity=".9" />
      <path d="M60 108c19-3 32-13 39-29-17-5-33 3-43 17" fill="url(#leaf)" opacity=".75" />
      <path d="M60 52c4-18 15-29 29-34-1 17-12 31-27 38" stroke="#5e684b" stroke-width="1.2" fill="#6a7354" fill-opacity=".5" />
      <circle cx="51" cy="156" r="2" fill="#3b2c1d" opacity=".5" />
    </svg>
  )}

  {variant === "candle" && (
    <div class="candle">
      <div class="candle__glow"></div>
      <div class="candle__flame"></div>
      <div class="candle__wick"></div>
      <div class="candle__body"></div>
      <div class="candle__holder"></div>
    </div>
  )}

  {variant === "stack" && (
    <svg viewBox="0 0 150 110" fill="none">
      <defs>
        <linearGradient id="bk1" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#9d8b70" />
          <stop offset="1" stop-color="#6f5b41" />
        </linearGradient>
        <linearGradient id="bk2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#7c4c43" />
          <stop offset="1" stop-color="#4c2d28" />
        </linearGradient>
        <linearGradient id="bk3" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#4e5d63" />
          <stop offset="1" stop-color="#2c363a" />
        </linearGradient>
      </defs>
      <rect x="20" y="76" width="108" height="20" rx="2" fill="url(#bk3)" />
      <rect x="23" y="79" width="100" height="2" fill="#d9c6a4" fill-opacity=".45" />
      <rect x="32" y="57" width="90" height="19" rx="2" fill="url(#bk2)" transform="rotate(-2 32 57)" />
      <rect x="29" y="38" width="97" height="19" rx="2" fill="url(#bk1)" transform="rotate(1.4 29 38)" />
      <rect x="34" y="42" width="84" height="1.4" fill="#f0e2c6" fill-opacity=".45" transform="rotate(1.4 34 42)" />
      <path d="M119 42v13" stroke="#d7bd8a" stroke-opacity=".5" />
      <rect x="18" y="96" width="114" height="4" rx="2" fill="#1c120c" fill-opacity=".55" />
    </svg>
  )}

  {variant === "bookend" && (
    <svg viewBox="0 0 70 120" fill="none">
      <defs>
        <linearGradient id="brass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#e5c78e" />
          <stop offset="0.5" stop-color="#9f7c45" />
          <stop offset="1" stop-color="#5f4524" />
        </linearGradient>
      </defs>
      <path d="M18 18h26v90H18z" fill="url(#brass)" opacity=".92" />
      <path d="M18 18h26v5H18z" fill="#f0ddb2" fill-opacity=".55" />
      <path d="M44 108h18v4H18v-4h10" stroke="url(#brass)" stroke-width="4" fill="none" />
      <circle cx="31" cy="36" r="3.2" fill="#3b2a16" fill-opacity=".55" />
      <path d="M24 24v78" stroke="#f6e6c2" stroke-opacity=".16" stroke-width="1" />
    </svg>
  )}

  {variant === "lamp" && (
    <div class="lamp">
      <div class="lamp__glow"></div>
      <svg viewBox="0 0 150 170" fill="none">
        <defs>
          <linearGradient id="lampShade" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#d9b476" />
            <stop offset="0.5" stop-color="#95703a" />
            <stop offset="1" stop-color="#5b421f" />
          </linearGradient>
        </defs>
        <ellipse cx="78" cy="156" rx="38" ry="5" fill="#0c0705" fill-opacity=".55" />
        <path d="M74 156V78c0-17 15-27 30-24" stroke="url(#lampShade)" stroke-width="5" stroke-linecap="round" />
        <path d="M104 54c18 0 27 12 27 26H77c0-14 9-26 27-26Z" fill="url(#lampShade)" />
        <path d="M82 80h44c0 13-8 20-22 20s-22-7-22-20Z" fill="#f3d9a4" fill-opacity=".18" />
        <path d="M87 80h34" stroke="#f4dfb2" stroke-opacity=".65" />
        <path d="M104 54v-6" stroke="#c9a86a" stroke-width="2" />
        <ellipse cx="74" cy="156" rx="15" ry="4" fill="url(#lampShade)" />
      </svg>
    </div>
  )}

  {variant === "ink" && (
    <svg viewBox="0 0 120 140" fill="none">
      <defs>
        <linearGradient id="inkstone" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#514a42" />
          <stop offset="1" stop-color="#211c18" />
        </linearGradient>
      </defs>
      <rect x="20" y="96" width="80" height="26" rx="8" fill="url(#inkstone)" />
      <ellipse cx="60" cy="103" rx="27" ry="7" fill="#0d0a08" fill-opacity=".72" />
      <path d="M64 94 88 44" stroke="#b89a68" stroke-width="3" stroke-linecap="round" />
      <path d="M88 44c5-9 13-11 18-6-1 9-8 14-18 12Z" fill="#3b352e" />
      <path d="M26 118h68" stroke="#8d8272" stroke-opacity=".25" />
    </svg>
  )}
</div>

<style>
  .decor {
    pointer-events: none;
    user-select: none;
    flex: 0 0 auto;
  }
  .decor svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.35));
  }

  .decor--plant {
    width: 6.2rem;
    opacity: 0.96;
  }
  .decor--candle {
    width: 2.4rem;
    display: flex;
    justify-content: center;
  }
  .decor--stack {
    width: 7.5rem;
  }
  .decor--bookend {
    width: 3.3rem;
  }
  .decor--lamp {
    width: 8rem;
  }
  .decor--ink {
    width: 5.2rem;
  }

  .candle {
    position: relative;
    width: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 0.1rem;
  }
  .candle__body {
    width: 0.62rem;
    height: 4.2rem;
    border-radius: 3px 3px 2px 2px;
    background: linear-gradient(90deg, #d8c5a2, #f1e2c4 45%, #b49a73);
    box-shadow:
      inset -1px 0 2px rgba(84, 59, 30, 0.4),
      0 2px 4px rgba(0, 0, 0, 0.4);
  }
  .candle__holder {
    width: 2.2rem;
    height: 0.45rem;
    margin-top: -0.05rem;
    border-radius: 50%;
    background: linear-gradient(180deg, #d3b170, #7a5b2b);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.45);
  }
  .candle__wick {
    width: 1px;
    height: 0.45rem;
    background: #2b2119;
  }
  .candle__flame {
    width: 0.52rem;
    height: 1.05rem;
    margin-bottom: -0.08rem;
    border-radius: 50% 50% 45% 45% / 62% 62% 38% 38%;
    background: radial-gradient(circle at 50% 68%, #fff7d4 0 24%, #ffd078 42%, #e88a35 72%, transparent 74%);
    filter: blur(0.2px);
    animation: flicker 2.8s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .candle__glow {
    position: absolute;
    bottom: 4.4rem;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 186, 92, 0.32), transparent 72%);
    animation: breathe 4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes flicker {
    0%,
    100% {
      transform: scale(1) rotate(-1deg);
      opacity: 0.95;
    }
    22% {
      transform: scale(0.94, 1.05) rotate(2deg);
      opacity: 0.85;
    }
    48% {
      transform: scale(1.04, 0.96) rotate(-2deg);
      opacity: 1;
    }
    71% {
      transform: scale(0.97, 1.03) rotate(1deg);
      opacity: 0.9;
    }
  }

  .lamp {
    position: relative;
  }
  .lamp__glow {
    position: absolute;
    left: 50%;
    top: 2.2rem;
    width: 14rem;
    height: 13rem;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(255, 196, 108, 0.22), transparent 68%);
    pointer-events: none;
  }
</style>
