---
import type { Book } from "../lib/library";
import { bookHref, coverFor } from "../lib/library";

interface Props {
  book: Book;
  href?: string;
  variant?: "shelf" | "hero" | "detail";
  width?: number | string;
  height?: number | string;
  depth?: number | string;
  tilt?: number;
  lean?: number;
  showTooltip?: boolean;
  eager?: boolean;
  class?: string;
  badge?: string;
}

const toCss = (value: number | string) =>
  typeof value === "number" ? `${value}px` : value;

const {
  book,
  href = bookHref(book),
  variant = "shelf",
  width = 152,
  height = 228,
  depth = 30,
  tilt = 18,
  lean = 0,
  showTooltip = true,
  eager = false,
  class: className = "",
  badge,
} = Astro.props;
---

<a
  class:list={["book-obj", `book-obj--${variant}`, className]}
  href={href}
  style={`--bw:${toCss(width)};--bh:${toCss(height)};--bd:${toCss(depth)};--ry:${tilt}deg;--rz:${lean}deg;--accent:${book.data.accent}`}
  aria-label={`${book.data.title} · ${book.data.author}`}
>
  <span class="book-obj__stage">
    <span class="book-obj__book">
      <span class="book-obj__back"></span>
      <span class="book-obj__pages"></span>
      <span class="book-obj__spine" aria-hidden="true">
        <span class="spine-rule"></span>
        <span class="spine-title">{book.data.title}</span>
        <span class="spine-author">{book.data.author}</span>
        <span class="spine-rule spine-rule--bottom"></span>
      </span>
      <span class="book-obj__cover">
        <img
          src={coverFor(book)}
          alt={`${book.data.title} 封面`}
          width="600"
          height="900"
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
        <span class="book-obj__grain" aria-hidden="true"></span>
      </span>
      <span class="book-obj__top" aria-hidden="true"></span>
      <span class="book-obj__headcap" aria-hidden="true"></span>
      {badge && <span class="book-obj__badge">{badge}</span>}
    </span>
    <span class="book-obj__shadow" aria-hidden="true"></span>
  </span>

  {showTooltip && (
    <span class="book-obj__tooltip" aria-hidden="true">
      <span class="book-obj__tooltip-title">{book.data.title}</span>
      <span class="book-obj__tooltip-meta">{book.data.author}</span>
    </span>
  )}
</a>

<style>
  .book-obj:hover,
  .book-obj:focus-visible {
    z-index: 25;
  }

  .book-obj {
    --book-ease: cubic-bezier(0.22, 0.68, 0.2, 1);
    position: relative;
    display: block;
    width: var(--bw);
    height: var(--bh);
    perspective: 1300px;
    perspective-origin: 50% 42%;
    flex: 0 0 auto;
    outline-offset: 8px;
  }

  .book-obj__stage {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .book-obj__book {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(1.5deg) rotateY(var(--ry)) rotateZ(var(--rz));
    transition: transform 600ms var(--book-ease);
    will-change: transform;
  }

  .book-obj__cover,
  .book-obj__back,
  .book-obj__spine,
  .book-obj__pages,
  .book-obj__top {
    position: absolute;
    display: block;
    backface-visibility: hidden;
  }

  .book-obj__cover {
    inset: 0;
    z-index: 5;
    transform: translateZ(calc(var(--bd) / 2));
    border-radius: 1px 4px 4px 1px;
    overflow: hidden;
    background: #24160f;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.28),
      inset 0 0 0 1px rgba(255, 237, 200, 0.08);
  }
  .book-obj__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.94) contrast(1.02);
  }
  .book-obj__grain {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(100deg, rgba(255, 255, 255, 0.14), transparent 34%, rgba(0, 0, 0, 0.14)),
      url("/textures/noise.png");
    background-size: auto, 160px;
    mix-blend-mode: overlay;
    opacity: 0.5;
    pointer-events: none;
  }

  .book-obj__back {
    inset: 0;
    z-index: 1;
    transform: translateZ(calc(var(--bd) / -2)) rotateY(180deg);
    border-radius: 2px;
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 55%, #150d08), #120b07);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
  }

  .book-obj__spine {
    top: 0;
    left: 0;
    z-index: 4;
    width: var(--bd);
    height: 100%;
    transform-origin: left center;
    transform: translateZ(calc(var(--bd) / -2)) rotateY(-90deg);
    border-radius: 2px 0 0 2px;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.4),
        transparent 22%,
        rgba(255, 255, 255, 0.1) 72%,
        rgba(0, 0, 0, 0.34)
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--accent) 78%, #0b0705),
        color-mix(in srgb, var(--accent) 92%, #000)
      );
    box-shadow:
      inset 1px 0 0 rgba(255, 236, 198, 0.13),
      inset -1px 0 0 rgba(0, 0, 0, 0.38);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--bd) * 0.22) 0;
    overflow: hidden;
  }
  .spine-title {
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: var(--font-serif);
    font-size: clamp(0.5rem, calc(var(--bw) * 0.062), 0.86rem);
    letter-spacing: 0.08em;
    line-height: 1.12;
    color: rgba(245, 230, 201, 0.9);
    max-height: 70%;
    overflow: hidden;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
  }
  .spine-author {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-size: 0.44rem;
    letter-spacing: 0.08em;
    color: rgba(245, 230, 201, 0.55);
    max-height: 22%;
    overflow: hidden;
  }
  .spine-rule {
    width: 55%;
    height: 1px;
    background: rgba(214, 184, 126, 0.5);
    flex: 0 0 auto;
  }
  .spine-rule--bottom {
    opacity: 0.7;
  }

  .book-obj__pages {
    top: 2px;
    right: 0;
    z-index: 2;
    width: var(--bd);
    height: calc(100% - 4px);
    transform-origin: right center;
    transform: translateZ(calc(var(--bd) / -2)) rotateY(90deg);
    border-radius: 0 2px 2px 0;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(90, 70, 45, 0.3) 0 1px,
        rgba(246, 233, 204, 0.9) 1px 2.6px
      );
    box-shadow: inset 1px 0 4px rgba(0, 0, 0, 0.24);
  }

  .book-obj__top {
    top: 0;
    left: 1px;
    z-index: 3;
    width: calc(100% - 2px);
    height: var(--bd);
    transform-origin: top center;
    transform: translateZ(calc(var(--bd) / -2)) rotateX(90deg);
    background:
      repeating-linear-gradient(
        0deg,
        rgba(246, 233, 204, 0.92) 0 1px,
        rgba(120, 96, 64, 0.32) 1px 2.4px
      );
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.18);
  }

  .book-obj__headcap {
    position: absolute;
    z-index: 6;
    top: 1px;
    left: 0;
    width: var(--bd);
    height: 2.5%;
    transform: translateZ(calc(var(--bd) / 2));
    background: color-mix(in srgb, var(--accent) 60%, #e8d5b5);
    opacity: 0.55;
    border-radius: 1px;
  }

  .book-obj__badge {
    position: absolute;
    z-index: 8;
    top: -0.6rem;
    right: -0.65rem;
    padding: 0.2rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: #1e140b;
    background: linear-gradient(180deg, #e5c98f, #be9557);
    border-radius: 1px;
    box-shadow: 0 4px 10px -4px rgba(0, 0, 0, 0.6);
    transform: translateZ(30px) rotateZ(3deg);
  }

  .book-obj__shadow {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: -0.85rem;
    height: 1rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.62), transparent 78%);
    filter: blur(5px);
    opacity: 0.62;
    transform: translateZ(-24px);
    transition:
      opacity 500ms var(--book-ease),
      transform 500ms var(--book-ease);
    pointer-events: none;
  }

  .book-obj__tooltip {
    position: absolute;
    z-index: 30;
    left: 50%;
    bottom: calc(100% + 0.9rem);
    width: max-content;
    max-width: 12rem;
    transform: translate(-50%, 6px);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.66rem;
    border: 1px solid color-mix(in srgb, var(--c-brass) 34%, transparent);
    background: color-mix(in srgb, var(--c-paper) 94%, black);
    color: var(--c-ink);
    box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.8);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
    text-align: center;
    border-radius: 2px;
  }
  .book-obj__tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) rotate(45deg) translateY(-3px);
    width: 6px;
    height: 6px;
    background: color-mix(in srgb, var(--c-paper) 94%, black);
    border-right: 1px solid color-mix(in srgb, var(--c-brass) 34%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--c-brass) 34%, transparent);
  }
  .book-obj__tooltip-title {
    font-family: var(--font-serif);
    font-size: 0.74rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .book-obj__tooltip-meta {
    font-family: var(--font-serif);
    font-size: 0.62rem;
    color: var(--c-muted);
    white-space: nowrap;
  }

  @media (hover: hover) {
    .book-obj:hover .book-obj__book,
    .book-obj:focus-visible .book-obj__book {
      transform: rotateX(0.5deg) rotateY(calc(var(--ry) * 0.24)) rotateZ(0deg)
        translateY(-0.7rem) translateZ(26px);
    }
    .book-obj:hover .book-obj__shadow,
    .book-obj:focus-visible .book-obj__shadow {
      opacity: 0.9;
      transform: translateZ(-20px) scale(1.12);
    }
    .book-obj:hover .book-obj__tooltip,
    .book-obj:focus-visible .book-obj__tooltip {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .book-obj--hero {
    --book-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .book-obj--hero .book-obj__book {
    transform:
      rotateX(calc(2deg + var(--book-mx, 0deg)))
      rotateY(calc(var(--ry) + var(--book-my, 0deg)))
      rotateZ(var(--rz));
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .book-obj--hero:hover .book-obj__book {
    transform:
      rotateX(calc(2deg + var(--book-mx, 0deg)))
      rotateY(calc(var(--ry) + var(--book-my, 0deg)))
      rotateZ(var(--rz))
      translateY(-0.55rem) translateZ(18px);
  }
  .book-obj--hero .book-obj__shadow {
    bottom: -1.4rem;
    height: 1.5rem;
    filter: blur(8px);
    opacity: 0.72;
  }

  .book-obj--detail .book-obj__book {
    transition: transform 700ms var(--book-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-obj__book,
    .book-obj__shadow,
    .book-obj__tooltip {
      transition-duration: 0.001ms !important;
    }
  }
</style>
