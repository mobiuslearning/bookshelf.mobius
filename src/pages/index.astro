---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Shelf from "../components/Shelf.astro";
import Icon from "../components/Icon.astro";
import { getBooks, getChapters, readingMinutes } from "../lib/library";
import { categories, site } from "../data/site";

const books = await getBooks();
const chapters = await getChapters();

const chapterStats: Record<string, { count: number; minutes: number }> = {};
for (const book of books) {
  const list = chapters.filter((chapter) => chapter.data.book === book.data.slug);
  chapterStats[book.data.slug] = {
    count: list.length,
    minutes: list.reduce((sum, chapter) => sum + readingMinutes(chapter.body), 0),
  };
}

const stats = {
  books: books.length,
  chapters: chapters.length,
  categories: categories.length,
};

const featured = books.find((book) => book.data.featured) ?? books[0];
const booksByCategory = Object.fromEntries(
  categories.map((category) => [
    category.key,
    books.filter((book) => book.data.category === category.key),
  ]),
) as Record<(typeof categories)[number]["key"], typeof books>;

const totalMinutes = Object.values(chapterStats).reduce(
  (sum, item) => sum + item.minutes,
  0,
);
---

<BaseLayout
  title={undefined}
  description={`${site.name}：${site.tagline}。收录 ${stats.books} 册书、${stats.chapters} 篇可读内容，分为经典名著、当下热门和我的作品三层书架。`}
  bodyClass="home"
>
  <Hero featured={featured} stats={stats} />

  <main id="main">
    <section class="preface shell reveal">
      <div class="preface-copy">
        <p class="eyebrow"><span>00</span> / BEFORE THE SHELVES</p>
        <h2>书房小引</h2>
        <p class="preface-lead">
          这里不是排行榜，也不是必读书单。只是一个把喜欢的书放在一起的地方。
        </p>
        <p>
          书架分三层：经典名著是经过时间挑选的旧书；当下热门是此刻正在被谈论的一本；
          我的作品放自己写下的字。你可以从任意一层开始，抽出一本，坐到窗边去。
        </p>
      </div>

      <aside class="preface-aside">
        <blockquote>
          <span class="quote-mark" aria-hidden="true">“</span>
          读书不是为了记住，<br />
          而是为了在某个时刻，<br />
          忽然懂得。
        </blockquote>
        <div class="preface-index">
          {categories.map((category) => (
            <a href={`#${category.key}`} class="preface-index__row">
              <span class="preface-index__num">{category.numeral}</span>
              <span class="preface-index__label">{category.label}</span>
              <span class="preface-index__count">{String(booksByCategory[category.key].length).padStart(2, "0")} 册</span>
              <span class="preface-index__arrow"><Icon name="arrow-right" size={13} /></span>
            </a>
          ))}
        </div>
      </aside>
    </section>

    <div id="shelf" class="shelf-stack">
      {categories.map((category) => (
        <Shelf
          category={category.key}
          books={booksByCategory[category.key]}
          chapterStats={chapterStats}
        />
      ))}
    </div>

    <section class="closing shell reveal">
      <div class="closing-frame">
        <div class="closing-copy">
          <p class="eyebrow">KEEP THE LAMP ON</p>
          <h2>书会慢慢变多，<br />书架不必一次成形。</h2>
          <p>
            这一架书现在有 {stats.books} 册、{stats.chapters} 篇，合起来约
            {Math.round(totalMinutes / 60)} 小时的阅读。经典名著收录导读与短书摘，
            《高性价比人生指南》依 CC BY 4.0 许可收录全文，三层书架都可以继续添书。
          </p>
          <div class="closing-actions">
            <a class="btn btn--brass" href="/about#add-book">
              看看怎样添书
              <Icon name="arrow-right" size={15} />
            </a>
            <a class="closing-link" href="/about">关于这间书房</a>
          </div>
        </div>

        <div class="closing-marks" aria-hidden="true">
          <span class="closing-mark">藏</span>
          <span class="closing-mark closing-mark--outline">書</span>
          <span class="closing-mark closing-mark--small">讀</span>
          <span class="closing-seal">木间</span>
          <span class="closing-rule"></span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .preface {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    padding-top: 5.5rem;
    padding-bottom: 2.5rem;
  }
  .preface::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 82rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-line) 16%, var(--c-line) 84%, transparent);
  }
  .preface-copy .eyebrow {
    margin: 0 0 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .preface-copy .eyebrow span {
    color: var(--c-brass);
  }
  .preface h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.3;
  }
  .preface-copy p {
    max-width: 36rem;
    margin: 1rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    line-height: 2.1;
    color: var(--c-muted);
  }
  .preface-copy .preface-lead {
    margin-top: 1.4rem;
    font-size: 1.02rem;
    color: var(--c-ink);
  }

  .preface-aside {
    position: relative;
    padding-left: 1.9rem;
    border-left: 1px solid var(--c-line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .preface-aside blockquote {
    position: relative;
    margin: 0;
    padding-top: 1.7rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 2.15;
    letter-spacing: 0.08em;
    color: var(--c-muted);
  }
  .quote-mark {
    position: absolute;
    top: -0.7rem;
    left: -0.2rem;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 1;
    color: color-mix(in srgb, var(--c-brass) 45%, transparent);
  }
  .preface-index {
    margin-top: 2rem;
    border-top: 1px solid var(--c-line);
  }
  .preface-index__row {
    display: grid;
    grid-template-columns: 1.4rem 1fr auto auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.72rem 0.1rem;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-muted);
    transition:
      color 180ms ease,
      padding-left 220ms ease;
  }
  .preface-index__row:hover {
    color: var(--c-brass);
    padding-left: 0.4rem;
  }
  .preface-index__num {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    color: var(--c-brass);
  }
  .preface-index__label {
    font-family: var(--font-serif);
    font-size: 0.84rem;
    letter-spacing: 0.08em;
  }
  .preface-index__count {
    font-family: var(--font-mono);
    font-size: 0.53rem;
    letter-spacing: 0.08em;
    color: var(--c-faint);
  }
  .preface-index__arrow {
    display: grid;
    place-items: center;
    opacity: 0.5;
  }

  .shelf-stack {
    position: relative;
    padding-top: 1.5rem;
  }
  .shelf-stack::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 10rem;
    background: linear-gradient(180deg, rgba(8, 5, 3, 0.35), transparent);
    pointer-events: none;
  }

  .closing {
    padding-top: 6rem;
    padding-bottom: 2rem;
  }
  .closing-frame {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--c-line);
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.035), transparent 46%),
      color-mix(in srgb, var(--c-panel) 62%, transparent);
    box-shadow:
      0 40px 80px -40px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 rgba(255, 238, 205, 0.06);
    overflow: hidden;
    backdrop-filter: blur(2px);
  }
  .closing-frame::before {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid color-mix(in srgb, var(--c-brass) 16%, transparent);
    pointer-events: none;
  }
  .closing-copy {
    position: relative;
    z-index: 2;
  }
  .closing-copy .eyebrow {
    margin: 0 0 1rem;
  }
  .closing-copy h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.08em;
  }
  .closing-copy p {
    max-width: 34rem;
    margin: 1.2rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.83rem;
    line-height: 2.05;
    color: var(--c-muted);
  }
  .closing-actions {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    margin-top: 1.9rem;
  }
  .closing-link {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    color: var(--c-muted);
    border-bottom: 1px solid var(--c-line);
    padding-bottom: 0.2rem;
    transition: color 180ms ease;
  }
  .closing-link:hover {
    color: var(--c-brass);
  }

  .closing-marks {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 15rem;
  }
  .closing-mark {
    position: absolute;
    font-family: var(--font-serif);
    font-size: 8rem;
    line-height: 1;
    color: rgba(213, 180, 124, 0.12);
  }
  .closing-mark:first-child {
    transform: translate(-1.7rem, -1.2rem) rotate(-4deg);
  }
  .closing-mark--outline {
    color: transparent;
    -webkit-text-stroke: 1px rgba(213, 180, 124, 0.22);
    transform: translate(1.8rem, 1.4rem) rotate(5deg);
    font-size: 6.5rem;
  }
  .closing-mark--small {
    transform: translate(4.2rem, -2.8rem) rotate(8deg);
    font-size: 2.4rem;
    color: transparent;
    -webkit-text-stroke: 1px rgba(213, 180, 124, 0.28);
  }
  .closing-seal {
    position: absolute;
    right: 8%;
    bottom: 10%;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid rgba(201, 97, 75, 0.55);
    color: rgba(201, 97, 75, 0.8);
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    transform: rotate(4deg);
  }
  .closing-rule {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(213, 180, 124, 0.34), transparent);
    transform: translate(-50%, -50%) rotate(-32deg);
  }

  @media (max-width: 900px) {
    .preface {
      grid-template-columns: 1fr;
      padding-top: 4rem;
      gap: 2.5rem;
    }
    .preface-aside {
      padding-left: 0;
      border-left: 0;
      padding-top: 1.5rem;
      border-top: 1px solid var(--c-line);
    }
    .closing-frame {
      grid-template-columns: 1fr;
    }
    .closing-marks {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .preface {
      padding-top: 3rem;
    }
    .preface h2 {
      font-size: 1.8rem;
    }
    .preface-copy p {
      font-size: 0.82rem;
    }
    .closing {
      padding-top: 4rem;
    }
    .closing-frame {
      padding: 1.6rem;
    }
    .closing-frame::before {
      inset: 6px;
    }
    .closing-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
    }
    .closing-actions .btn {
      width: 100%;
    }
  }
</style>
