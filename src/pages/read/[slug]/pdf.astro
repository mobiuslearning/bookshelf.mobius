---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";
import { getBooks, type Book } from "../../../lib/library";
import { categoryMeta } from "../../../lib/library";

export async function getStaticPaths() {
  const books = await getBooks();
  return books
    .filter((book) => book.data.format === "pdf")
    .map((book) => ({
      params: { slug: book.data.slug },
      props: { book },
    }));
}

interface Props {
  book: Book;
}

const { book } = Astro.props;
const meta = categoryMeta(book.data.category);
const file = book.data.file;
---

<BaseLayout
  title={`${book.data.title} · PDF 翻阅`}
  description={book.data.description}
  bodyClass="pdf-page"
  hideFooter={true}
>
  <main id="main" class="pdf-main">
    <div class="pdf-top">
      <div class="shell pdf-top__inner">
        <a class="pdf-back" href={`/book/${book.data.slug}`}>
          <Icon name="arrow-left" size={14} />
          返回书页
        </a>
        <span class="pdf-divider" aria-hidden="true"></span>
        <span class="pdf-kicker">{meta.labelEn} · PDF</span>
        <span class="pdf-title">{book.data.title}</span>
        <div class="pdf-actions">
          {file && (
            <>
              <a href={file} target="_blank" rel="noreferrer">
                <Icon name="external" size={14} /> 新窗口打开
              </a>
              <a href={file} download>
                <Icon name="download" size={14} /> 下载
              </a>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="shell pdf-shell">
      <div class="pdf-heading">
        <p class="eyebrow">{meta.numeral} · {meta.label} / PDF EDITION</p>
        <h1>{book.data.title}</h1>
        <p class="pdf-author">{book.data.author}{book.data.year ? ` · ${book.data.year}` : ""}</p>
      </div>

      {file ? (
        <div class="pdf-reader" data-pdf-viewer data-src={file}>
          <div class="pdf-toolbar">
            <button type="button" class="pdf-tool" data-pdf-prev aria-label="上一页">
              <Icon name="arrow-left" size={14} />
            </button>
            <span class="pdf-counter" aria-live="polite">
              <b data-pdf-current>1</b>
              <span>/</span>
              <span data-pdf-total>—</span>
            </span>
            <button type="button" class="pdf-tool" data-pdf-next aria-label="下一页">
              <Icon name="arrow-right" size={14} />
            </button>

            <span class="pdf-toolbar__divider" aria-hidden="true"></span>

            <button type="button" class="pdf-tool pdf-tool--text" data-pdf-zoom-out aria-label="缩小 A−">A−</button>
            <span class="pdf-zoom" data-pdf-zoom>100%</span>
            <button type="button" class="pdf-tool pdf-tool--text" data-pdf-zoom-in aria-label="放大 A+">A+</button>
            <button type="button" class="pdf-fit" data-pdf-fit>适应宽度</button>

            <a class="pdf-download" href={file} download>
              <Icon name="download" size={13} />
              <span>下载 PDF</span>
            </a>
          </div>

          <div class="pdf-stage" role="region" tabindex="0" aria-label="PDF 阅读区域">
            <div class="pdf-loading" data-pdf-loading>
              <span class="spinner" aria-hidden="true"></span>
              正在打开 PDF…
            </div>
            <canvas data-pdf-canvas></canvas>
            <div class="pdf-error" data-pdf-error hidden>
              <p>PDF 阅读器没有成功打开这个文件。</p>
              <a class="btn btn--ghost btn--small" href={file} download>
                <Icon name="download" size={14} /> 直接下载 PDF
              </a>
            </div>
          </div>

          <div class="pdf-foot">
            <span><kbd>←</kbd><kbd>→</kbd> 翻页</span>
            <span>由 PDF.js 在本地渲染，文件不会上传。</span>
            <a href={`/book/${book.data.slug}`}>回到书页 <Icon name="arrow-right" size={12} /></a>
          </div>
        </div>
      ) : (
        <div class="pdf-missing">
          <p class="eyebrow">NO FILE YET</p>
          <h2>这一本还没有放进 PDF 文件。</h2>
          <p>在 <code>book.yaml</code> 里填写 <code>file</code> 字段，或运行 <code>pnpm book:new</code> 重新上架。</p>
          <a class="btn btn--brass" href={`/book/${book.data.slug}`}>回到书页</a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<script>
  const viewer = document.querySelector<HTMLElement>("[data-pdf-viewer]");
  const file = viewer?.dataset.src;

  if (viewer && file) {
    if (!("withResolvers" in Promise)) {
      // PDF.js uses this small helper in older Chromium builds.
      (Promise as unknown as { withResolvers: () => unknown }).withResolvers = function () {
        let resolve!: (value: unknown) => void;
        let reject!: (reason?: unknown) => void;
        const promise = new Promise((res, rej) => {
          resolve = res;
          reject = rej;
        });
        return { promise, resolve, reject };
      };
    }

    const canvas = viewer.querySelector<HTMLCanvasElement>("[data-pdf-canvas]");
    const stage = viewer.querySelector<HTMLElement>(".pdf-stage");
    const loading = viewer.querySelector<HTMLElement>("[data-pdf-loading]");
    const errorBox = viewer.querySelector<HTMLElement>("[data-pdf-error]");
    const currentEl = viewer.querySelector<HTMLElement>("[data-pdf-current]");
    const totalEl = viewer.querySelector<HTMLElement>("[data-pdf-total]");
    const zoomEl = viewer.querySelector<HTMLElement>("[data-pdf-zoom]");
    const prev = viewer.querySelector<HTMLButtonElement>("[data-pdf-prev]");
    const next = viewer.querySelector<HTMLButtonElement>("[data-pdf-next]");

    let pdfDoc: any = null;
    let pageNumber = 1;
    let zoom = 1;
    let renderTask: any = null;
    let renderToken = 0;
    let resizeTimer = 0;

    const setLoading = (visible: boolean) => {
      if (loading) loading.hidden = !visible;
    };
    const showError = () => {
      setLoading(false);
      if (errorBox) errorBox.hidden = false;
    };

    const renderPage = async () => {
      if (!pdfDoc || !canvas || !stage) return;
      const token = ++renderToken;
      const page = await pdfDoc.getPage(pageNumber);
      if (token !== renderToken) return;
      const base = page.getViewport({ scale: 1 });
      const available = Math.max(240, stage.clientWidth - 48);
      const fit = available / base.width;
      const scale = fit * zoom;
      const viewport = page.getViewport({ scale });
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.floor(viewport.width * dpr);
      canvas.height = Math.floor(viewport.height * dpr);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.height = `${Math.floor(viewport.height)}px`;
      const context = canvas.getContext("2d", { alpha: false });
      if (!context) return;
      context.save();
      context.fillStyle = "#ffffff";
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.restore();
      renderTask?.cancel();
      renderTask = page.render({
        canvasContext: context,
        viewport: page.getViewport({ scale: scale * dpr }),
      });
      try {
        await renderTask.promise;
      } catch (error: any) {
        if (error?.name !== "RenderingCancelledException") throw error;
      }
      if (token === renderToken) {
        setLoading(false);
        if (currentEl) currentEl.textContent = String(pageNumber);
        if (totalEl) totalEl.textContent = String(pdfDoc.numPages);
        if (zoomEl) zoomEl.textContent = `${Math.round(zoom * 100)}%`;
        if (prev) prev.disabled = pageNumber <= 1;
        if (next) next.disabled = pageNumber >= pdfDoc.numPages;
      }
    };

    const changePage = (delta: number) => {
      if (!pdfDoc) return;
      pageNumber = Math.min(pdfDoc.numPages, Math.max(1, pageNumber + delta));
      void renderPage();
    };

    const changeZoom = (factor: number) => {
      zoom = Math.min(2.6, Math.max(0.7, Number((zoom * factor).toFixed(2))));
      void renderPage();
    };

    viewer.querySelector("[data-pdf-prev]")?.addEventListener("click", () => changePage(-1));
    viewer.querySelector("[data-pdf-next]")?.addEventListener("click", () => changePage(1));
    viewer.querySelector("[data-pdf-zoom-out]")?.addEventListener("click", () => changeZoom(0.82));
    viewer.querySelector("[data-pdf-zoom-in]")?.addEventListener("click", () => changeZoom(1.22));
    viewer.querySelector("[data-pdf-fit]")?.addEventListener("click", () => {
      zoom = 1;
      void renderPage();
    });
    stage?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        changePage(-1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        changePage(1);
      }
    });
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => void renderPage(), 180);
    });

    (async () => {
      try {
        const pdfjs = await import("pdfjs-dist/build/pdf.mjs");
        const worker = await import("pdfjs-dist/build/pdf.worker.min.mjs?url");
        pdfjs.GlobalWorkerOptions.workerSrc = worker.default;
        pdfDoc = await pdfjs.getDocument({ url: file }).promise;
        setLoading(false);
        await renderPage();
      } catch (error) {
        console.error("PDF viewer failed:", error);
        showError();
      }
    })();
  }
</script>

<style>
  .pdf-main {
    padding-top: var(--header-h);
    min-height: 100vh;
  }
  .pdf-top {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    background: color-mix(in srgb, var(--c-paper) 80%, transparent);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--c-line);
  }
  .pdf-top__inner {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    height: 3rem;
    font-family: var(--font-serif);
    font-size: 0.68rem;
  }
  .pdf-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--c-muted);
  }
  .pdf-back:hover {
    color: var(--c-brass);
  }
  .pdf-divider {
    width: 1px;
    height: 0.8rem;
    background: var(--c-line);
  }
  .pdf-kicker {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--c-brass);
  }
  .pdf-title {
    color: var(--c-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdf-actions {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }
  .pdf-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--c-muted);
  }
  .pdf-actions a:hover {
    color: var(--c-brass);
  }

  .pdf-shell {
    padding-top: 2.6rem;
    padding-bottom: 4rem;
  }
  .pdf-heading {
    text-align: center;
    padding-bottom: 1.8rem;
  }
  .pdf-heading .eyebrow {
    margin: 0 0 0.8rem;
  }
  .pdf-heading h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .pdf-author {
    margin: 0.6rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.76rem;
    color: var(--c-faint);
  }

  .pdf-reader {
    max-width: 66rem;
    margin: 0 auto;
    border: 1px solid var(--c-line);
    background: color-mix(in srgb, var(--c-panel) 64%, transparent);
    box-shadow:
      0 40px 90px -50px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 238, 205, 0.05);
  }
  .pdf-toolbar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid var(--c-line);
    background: color-mix(in srgb, var(--c-paper) 46%, transparent);
  }
  .pdf-tool,
  .pdf-fit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.85rem;
    height: 1.85rem;
    padding: 0 0.45rem;
    border: 1px solid var(--c-line);
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 0.68rem;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .pdf-tool:hover,
  .pdf-fit:hover {
    color: var(--c-brass);
    border-color: color-mix(in srgb, var(--c-brass) 45%, transparent);
    background: color-mix(in srgb, var(--c-brass) 6%, transparent);
  }
  .pdf-tool:disabled {
    opacity: 0.3;
    cursor: default;
    transform: none;
  }
  .pdf-tool--text {
    font-family: var(--font-display);
    font-size: 0.9rem;
  }
  .pdf-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--c-faint);
  }
  .pdf-counter b {
    font-weight: 400;
    color: var(--c-ink);
  }
  .pdf-zoom {
    min-width: 3rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    color: var(--c-faint);
  }
  .pdf-toolbar__divider {
    width: 1px;
    height: 1.1rem;
    background: var(--c-line);
    margin: 0 0.2rem;
  }
  .pdf-download {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    font-family: var(--font-serif);
    font-size: 0.62rem;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }
  .pdf-download:hover {
    color: var(--c-brass);
    border-color: color-mix(in srgb, var(--c-brass) 45%, transparent);
  }

  .pdf-stage {
    position: relative;
    min-height: min(74vh, 52rem);
    max-height: min(82vh, 60rem);
    overflow: auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 1.5rem;
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(255, 200, 130, 0.06), transparent 70%),
      #17110d;
    outline: none;
  }
  .pdf-stage:focus-visible {
    outline: 1px solid var(--c-brass);
    outline-offset: -1px;
  }
  .pdf-stage canvas {
    display: block;
    background: #fff;
    box-shadow:
      0 20px 50px -20px rgba(0, 0, 0, 0.75),
      0 2px 6px rgba(0, 0, 0, 0.4);
    max-width: none;
    height: auto;
  }
  .pdf-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    font-family: var(--font-serif);
    font-size: 0.72rem;
    color: var(--c-faint);
    background: rgba(20, 14, 10, 0.82);
    z-index: 2;
  }
  .pdf-loading[hidden] {
    display: none;
  }
  .spinner {
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--c-line);
    border-top-color: var(--c-brass);
    border-radius: 50%;
    animation: pdf-spin 900ms linear infinite;
  }
  @keyframes pdf-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .pdf-error {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: #17110d;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    color: var(--c-muted);
    z-index: 3;
  }
  .pdf-error[hidden] {
    display: none;
  }
  .pdf-foot {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--c-line);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--c-faint);
  }
  .pdf-foot a {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-serif);
    color: var(--c-muted);
  }
  .pdf-foot a:hover {
    color: var(--c-brass);
  }
  .pdf-foot kbd {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    border: 1px solid var(--c-line);
    padding: 0.08rem 0.22rem;
    margin-right: 0.15rem;
    border-radius: 1px;
  }
  .pdf-foot span:nth-child(2) {
    margin-left: 0.4rem;
  }

  .pdf-missing {
    max-width: 34rem;
    margin: 0 auto;
    padding: 3rem;
    border: 1px solid var(--c-line);
    text-align: center;
    font-family: var(--font-serif);
  }
  .pdf-missing h2 {
    margin: 0.6rem 0 0;
    font-size: 1.4rem;
    font-weight: 500;
  }
  .pdf-missing p {
    font-size: 0.78rem;
    line-height: 2;
    color: var(--c-muted);
  }
  .pdf-missing code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.1rem 0.3rem;
    background: color-mix(in srgb, var(--c-brass) 10%, transparent);
  }
  .pdf-missing .btn {
    margin-top: 1rem;
  }

  @media (max-width: 720px) {
    .pdf-kicker,
    .pdf-divider,
    .pdf-actions a:first-child,
    .pdf-toolbar__divider,
    .pdf-fit,
    .pdf-download span,
    .pdf-foot span:nth-child(2) {
      display: none;
    }
    .pdf-toolbar {
      gap: 0.35rem;
      padding: 0.5rem;
    }
    .pdf-download {
      margin-left: auto;
      padding: 0.35rem 0.5rem;
    }
    .pdf-stage {
      padding: 0.6rem;
      min-height: 68vh;
      max-height: 78vh;
    }
    .pdf-zoom {
      min-width: 2.6rem;
    }
    .pdf-shell {
      padding-top: 2rem;
    }
    .pdf-foot {
      flex-wrap: wrap;
    }
  }
</style>
